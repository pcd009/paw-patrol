{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "behavior_event.json",
  "title": "BehaviorEvent",
  "description": "A candidate observation from a detector (video, audio, or on-device sensor). Detectors never decide whether the dog needs attention.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "subject_id", "source", "label", "confidence", "started_at", "ended_at", "zone", "evidence"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "event_id": { "type": "string", "pattern": "^evt_[A-Za-z0-9]+$" },
    "subject_id": { "type": "string" },
    "source": { "enum": ["video", "audio", "sensor"] },
    "label": {
      "enum": [
        "walking", "trotting", "galloping", "sitting", "standing",
        "lying_on_chest", "sniffing", "barking", "whining", "button_press"
      ]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "started_at": { "type": "string", "format": "date-time", "description": "UTC ISO-8601 with Z" },
    "ended_at": { "type": "string", "format": "date-time", "description": "UTC ISO-8601 with Z; equals started_at for instantaneous events" },
    "zone": {
      "enum": ["door_area", "bed_area", "food_area", "play_area", "unknown"],
      "description": "Where the dog was. Audio events copy the dog's last known video zone (or 'unknown')."
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clip_id": { "type": "string" },
        "clip_start_ms": { "type": "integer", "minimum": 0 },
        "clip_end_ms": { "type": "integer", "minimum": 0 },
        "frame_start": { "type": "integer", "minimum": 0 },
        "frame_end": { "type": "integer", "minimum": 0 },
        "device_id": { "type": "string" },
        "detector": { "type": "string", "description": "e.g. yolov8n+heuristics, yamnet, esp32_button" }
      }
    }
  }
}
