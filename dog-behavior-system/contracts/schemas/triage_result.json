{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "triage_result.json",
  "title": "TriageResult",
  "description": "LLM interpretation of one ContextPacket. Advisory only: it can never create, modify, or dismiss an Alert.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "triage_id", "context_id", "subject_id", "created_at", "model", "decision", "confidence", "evidence_event_ids", "referenced_alert_ids", "owner_message", "uncertainty", "suggested_check"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "triage_id": { "type": "string", "pattern": "^triage_[A-Za-z0-9]+$" },
    "context_id": { "type": "string" },
    "subject_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "model": { "type": "string", "description": "Model id, or 'mock' / 'fallback'" },
    "decision": { "enum": ["routine", "monitor", "notify", "insufficient_evidence"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence_event_ids": { "type": "array", "items": { "type": "string" }, "description": "Must be a subset of the packet's event ids" },
    "referenced_alert_ids": { "type": "array", "items": { "type": "string" }, "description": "Must be a subset of the packet's active_alerts ids" },
    "owner_message": { "type": "string" },
    "uncertainty": { "type": "string" },
    "suggested_check": { "type": "string" }
  }
}
